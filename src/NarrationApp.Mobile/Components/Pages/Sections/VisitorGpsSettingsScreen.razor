@using NarrationApp.Mobile.Features.Home

<section class="settings-detail-screen">
    <header class="settings-detail-header">
        <button type="button" class="icon-button" @onclick="OnBack">←</button>
        <div>
            <span class="eyebrow">GPS settings</span>
            <h2>@Text.GpsSettingsTitle</h2>
            <p>@Text.GpsSettingsDescription()</p>
        </div>
    </header>

    <article class="setting-card settings-gps-status">
        <span class="sheet-label">@Text.CurrentStatusLabel()</span>
        <strong>@StatusLabel</strong>
        <p>@Text.LocalizeKnownStatus(Preferences.StatusLabel)</p>
        <div class="auth-inline auth-inline--summary">
            <span>@Text.BatteryLabel(Preferences.BatteryPercent)</span>
            <span>@Text.LocalizeKnownStatus(Preferences.BatteryLabel)</span>
        </div>
    </article>

    <article class="setting-card">
        <span class="sheet-label">@Text.BackgroundTrackingLabel()</span>

        <button type="button" class="settings-toggle-row" @onclick="() => OnBackgroundTrackingChanged.InvokeAsync(!Preferences.BackgroundTrackingEnabled)">
            <div class="settings-row__copy">
                <strong class="settings-row__title">@Text.BackgroundGeofenceTitle()</strong>
                <span class="settings-row__subtitle">@Text.BackgroundGeofenceDescription()</span>
            </div>
            <span class="settings-switch @(Preferences.BackgroundTrackingEnabled ? "is-on" : string.Empty)">@GetToggleLabel(Preferences.BackgroundTrackingEnabled)</span>
        </button>

        <button type="button" class="settings-toggle-row" @onclick="() => OnAutoFocusChanged.InvokeAsync(!Preferences.AutoFocusEnabled)">
            <div class="settings-row__copy">
                <strong class="settings-row__title">@Text.GpsAutoFocusTitle()</strong>
                <span class="settings-row__subtitle">@Text.GpsAutoFocusDescription()</span>
            </div>
            <span class="settings-switch @(Preferences.AutoFocusEnabled ? "is-on" : string.Empty)">@GetToggleLabel(Preferences.AutoFocusEnabled)</span>
        </button>
    </article>

    <article class="setting-card">
        <span class="sheet-label">@Text.GpsAccuracyLabel()</span>
        <div class="settings-segment">
            @foreach (var mode in Enum.GetValues<VisitorGpsAccuracyMode>())
            {
                <button
                    type="button"
                    class="settings-segment__button @(Preferences.AccuracyMode == mode ? "is-selected" : string.Empty)"
                    @onclick="() => OnAccuracyModeChanged.InvokeAsync(mode)">
                    @GetAccuracyLabel(mode)
                </button>
            }
        </div>
        <p>@GetAccuracyDescription(Preferences.AccuracyMode)</p>
    </article>

    <article class="setting-card settings-debug-log">
        <span class="sheet-label">@Text.GpsDebugLogLabel()</span>
        @if (GeofenceDebugEvents.Count == 0)
        {
            <div class="debug-log-item debug-log-item--empty">
                <strong>@Text.GpsDebugEmptyTitle()</strong>
                <span>@Text.GpsDebugEmptyDescription()</span>
            </div>
        }
        else
        {
            <div class="debug-log-list">
                @foreach (var item in GeofenceDebugEvents)
                {
                    <article class="debug-log-item">
                        <strong>@item.TimeLabel</strong>
                        <span>@Text.LocalizeKnownStatus(item.Message)</span>
                    </article>
                }
            </div>
        }
    </article>
</section>

@code {
    [Parameter] public VisitorGpsPreferences Preferences { get; set; } = new(true, true, VisitorGpsAccuracyMode.Adaptive, 0, string.Empty, string.Empty);
    [Parameter] public VisitorUiText Text { get; set; } = VisitorUiTextCatalog.ForLanguage("vi");
    [Parameter] public IReadOnlyList<VisitorDebugEvent> GeofenceDebugEvents { get; set; } = [];
    [Parameter] public string StatusLabel { get; set; } = string.Empty;
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback<bool> OnBackgroundTrackingChanged { get; set; }
    [Parameter] public EventCallback<bool> OnAutoFocusChanged { get; set; }
    [Parameter] public EventCallback<VisitorGpsAccuracyMode> OnAccuracyModeChanged { get; set; }

    private string GetToggleLabel(bool isEnabled) => Text.ToggleLabel(isEnabled);

    private static string GetAccuracyLabel(VisitorGpsAccuracyMode mode) =>
        mode switch
        {
            VisitorGpsAccuracyMode.High => "High",
            VisitorGpsAccuracyMode.BatterySaver => "Battery",
            _ => "Adaptive"
        };

    private string GetAccuracyDescription(VisitorGpsAccuracyMode mode) =>
        Text.AccuracyDescription(mode);
}
