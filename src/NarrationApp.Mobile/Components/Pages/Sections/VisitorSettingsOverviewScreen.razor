@using NarrationApp.Mobile.Features.Home

<section class="stack-section settings-screen">
    <article class="setting-card settings-profile-card">
        <div class="settings-profile-card__top">
            <div class="settings-avatar">@VisitorMode.Initials</div>
            <div class="settings-row__copy">
                <span class="eyebrow">@Text.CurrentDeviceLabel</span>
                <strong class="settings-row__title">@VisitorMode.Title</strong>
                <span class="settings-row__subtitle">@VisitorMode.Subtitle</span>
                <span class="settings-row__subtitle">@VisitorMode.ModeLabel</span>
            </div>
        </div>

        <div class="settings-stat-grid">
            @foreach (var stat in Stats)
            {
                <div class="settings-stat">
                    <strong>@stat.Value</strong>
                    <span>@stat.Label</span>
                </div>
            }
        </div>
    </article>

    <article class="setting-card">
        <span class="sheet-label">@Text.AppLanguageLabel</span>
        <strong>@Overview.CurrentLanguageLabel</strong>
        <p>@Text.AppLanguageDescription</p>

        <label class="settings-language-dropdown">
            <span>@Text.SettingsLanguageSelectLabel</span>
            <select class="settings-language-select" value="@SelectedLanguageCode" @onchange="OnLanguageChangedAsync">
                @foreach (var language in Languages)
                {
                    <option value="@language.Code">@language.ChipLabel • @Text.LocalizeLanguageLabel(language.Label)</option>
                }
            </select>
        </label>
    </article>

    <div class="settings-nav-list">
        <button type="button" class="setting-card settings-row" @onclick="OnOpenAudio">
            <div class="settings-row__copy">
                <strong class="settings-row__title">@Text.AudioSettingsTitle</strong>
                <span class="settings-row__subtitle">@Overview.AudioSummary</span>
            </div>
            <span class="settings-row__value">›</span>
        </button>

        <button type="button" class="setting-card settings-row" @onclick="OnOpenGps">
            <div class="settings-row__copy">
                <strong class="settings-row__title">@Text.GpsSettingsTitle</strong>
                <span class="settings-row__subtitle">@Overview.GpsSummary</span>
            </div>
            <span class="settings-row__value">›</span>
        </button>

        <button type="button" class="setting-card settings-row" @onclick="OnOpenCache">
            <div class="settings-row__copy">
                <strong class="settings-row__title">@Text.ContentAudioCacheTitle</strong>
                <span class="settings-row__subtitle">@Overview.CacheSummary</span>
            </div>
            <span class="settings-row__value">›</span>
        </button>

        <button type="button" class="setting-card settings-row" @onclick="OnOpenHistory">
            <div class="settings-row__copy">
                <strong class="settings-row__title">@Text.ListenHistoryTitle</strong>
                <span class="settings-row__subtitle">@Overview.HistorySummary</span>
            </div>
            <span class="settings-row__value">›</span>
        </button>

        <button type="button" class="setting-card settings-row" @onclick="OnOpenAbout">
            <div class="settings-row__copy">
                <strong class="settings-row__title">@Text.AboutAppTitle</strong>
                <span class="settings-row__subtitle">@Overview.AboutSummary</span>
            </div>
            <span class="settings-row__value">›</span>
        </button>
    </div>
</section>

@code {
    [Parameter] public VisitorModeSummary VisitorMode { get; set; } = new(string.Empty, string.Empty, string.Empty, "GT");
    [Parameter] public VisitorUiText Text { get; set; } = VisitorUiTextCatalog.ForLanguage("vi");
    [Parameter] public VisitorSettingsOverviewSummary Overview { get; set; } = new(string.Empty, string.Empty, string.Empty, string.Empty, string.Empty, string.Empty);
    [Parameter] public IReadOnlyList<VisitorSettingsStat> Stats { get; set; } = [];
    [Parameter] public IReadOnlyList<VisitorLanguageOption> Languages { get; set; } = [];
    [Parameter] public string SelectedLanguageCode { get; set; } = "vi";
    [Parameter] public EventCallback<string> OnSelectLanguage { get; set; }
    [Parameter] public EventCallback OnOpenAudio { get; set; }
    [Parameter] public EventCallback OnOpenGps { get; set; }
    [Parameter] public EventCallback OnOpenCache { get; set; }
    [Parameter] public EventCallback OnOpenHistory { get; set; }
    [Parameter] public EventCallback OnOpenAbout { get; set; }

    private Task OnLanguageChangedAsync(ChangeEventArgs args)
    {
        var languageCode = args.Value?.ToString();
        return string.IsNullOrWhiteSpace(languageCode)
            ? Task.CompletedTask
            : OnSelectLanguage.InvokeAsync(languageCode);
    }
}
