@using NarrationApp.Mobile.Features.Home

<main class="visitor-app visitor-app--setup">
    <section class="setup-card @GetSetupCardClass()">
        <div class="setup-phone-chrome">
            <div class="setup-statusbar">
                <span class="setup-statusbar__time">16:02</span>
                <span class="setup-dynamic-island" aria-hidden="true"></span>
                <span class="setup-statusbar__system">📶 🔋 85%</span>
            </div>
        </div>

        @switch (State.CurrentStep)
        {
            case VisitorIntroStep.Welcome:
                <div class="setup-stack setup-stack--welcome">
                    <div class="setup-welcome-hero">
                        <span class="setup-welcome-icon" aria-hidden="true">🎧</span>
                        <h1>@Text.WelcomeTitlePrefix <span>NarrationApp</span></h1>
                        <p class="setup-copy setup-copy--centered">
                            @Text.WelcomeDescription
                        </p>
                    </div>

                    <div class="setup-feature-list">
                        <article class="setup-feature-card">
                            <span aria-hidden="true">📍</span>
                            <p><strong>@Text.FeatureAutoPlayTitle</strong> @Text.FeatureAutoPlayBody</p>
                        </article>
                        <article class="setup-feature-card">
                            <span aria-hidden="true">🌐</span>
                            <p><strong>@Text.FeatureLanguageTitle</strong> — @Text.FeatureLanguageBody</p>
                        </article>
                        <article class="setup-feature-card">
                            <span aria-hidden="true">🗺️</span>
                            <p><strong>@Text.FeatureTourTitle</strong> — @Text.FeatureTourBody</p>
                        </article>
                    </div>

                    <div class="setup-actions setup-actions--stacked setup-actions--welcome">
                        <button type="button" class="primary-pill primary-pill--wide setup-cta-button" @onclick="OnContinueWelcome">
                            @Text.StartExploringButton
                        </button>
                    </div>
                </div>
                break;

            case VisitorIntroStep.Language:
                <div class="setup-stack setup-stack--language">
                    <div class="setup-intro setup-intro--language">
                        <span class="setup-hero-icon" aria-hidden="true">🌐</span>
                        <div class="setup-intro__copy">
                            <h1>@Text.LanguageTitle</h1>
                            <p class="setup-copy">
                                @Text.LanguageDescription
                            </p>
                        </div>
                    </div>

                    <div class="setup-language-list">
                        @foreach (var language in State.AppLanguages)
                        {
                            var isSelected = string.Equals(State.SelectedAppLanguageCode, language.Code, StringComparison.Ordinal);
                            <button
                                type="button"
                                class="setup-language-option @LanguageTileClassSelector(language.Code)"
                                @onclick="() => OnSelectLanguage.InvokeAsync(language.Code)">
                                <span class="setup-language-option__code">@language.ChipLabel</span>
                                <span class="setup-language-option__copy">
                                    <strong>@Text.LocalizeLanguageLabel(language.Label)</strong>
                                    <span>@Text.LocalizeLanguageLabel(language.SubLabel)</span>
                                </span>
                                <span class="setup-language-option__indicator" aria-hidden="true">
                                    @if (isSelected)
                                    {
                                        <span class="setup-language-option__indicator-dot">✓</span>
                                    }
                                </span>
                            </button>
                        }
                    </div>

                    <div class="setup-actions setup-actions--stacked">
                        <button type="button" class="primary-pill primary-pill--wide setup-cta-button" @onclick="OnContinueLanguage">
                            @Text.ContinueButton
                        </button>
                    </div>
                </div>
                break;

            case VisitorIntroStep.Permissions:
                <div class="setup-stack setup-stack--permissions">
                    <div class="setup-permission-hero">
                        <span class="setup-permission-icon" aria-hidden="true">📍</span>
                        <h1>@Text.LocationPermissionTitle</h1>
                        <p class="setup-copy setup-copy--centered">
                            @Text.LocationPermissionDescription
                        </p>
                    </div>

                    <div class="setup-actions setup-actions--stacked">
                        <button type="button" class="primary-pill primary-pill--wide setup-cta-button" @onclick="OnEnableLocation">
                            @Text.EnableLocationButton
                        </button>
                    </div>
                </div>
                break;
        }
    </section>
</main>

@code {
    [Parameter] public VisitorShellState State { get; set; } = default!;
    [Parameter] public VisitorUiText Text { get; set; } = VisitorUiTextCatalog.ForLanguage("vi");
    [Parameter] public Func<string, string> LanguageTileClassSelector { get; set; } = static _ => string.Empty;
    [Parameter] public EventCallback OnContinueWelcome { get; set; }
    [Parameter] public EventCallback<string> OnSelectLanguage { get; set; }
    [Parameter] public EventCallback OnContinueLanguage { get; set; }
    [Parameter] public EventCallback OnEnableLocation { get; set; }

    private string GetSetupCardClass() => State.CurrentStep switch
    {
        VisitorIntroStep.Welcome => "setup-card--welcome",
        VisitorIntroStep.Language => "setup-card--language",
        _ => "setup-card--permissions"
    };
}
