@using NarrationApp.Mobile.Features.Home

<section class="map-screen">
    <div class="map-shell">
        <div class="map-canvas map-canvas--full">
            <div id="discover-map" class="map-surface"></div>

            <div class="map-top-overlay @(State.ShowPoiSheet ? "map-top-overlay--sheet-open" : string.Empty)">
                <div class="map-top-controls">
                    <button type="button" class="map-icon-button" @onclick="OnToggleNotifications">
                        <svg class="map-icon-glyph" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 4.5a3 3 0 0 0-3 3v.7a6.5 6.5 0 0 1-1.5 4.1L6 14.1v1.4h12v-1.4l-1.5-1.8A6.5 6.5 0 0 1 15 8.2v-.7a3 3 0 0 0-3-3Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
                            <path d="M10.2 18a1.8 1.8 0 0 0 3.6 0" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" />
                        </svg>
                    </button>
                </div>

                <div class="map-category-rail">
                    <section class="category-strip category-strip--map">
                        @foreach (var category in State.Categories)
                        {
                            <button
                                type="button"
                                class="category-chip @CategoryChipClassSelector(category.Id)"
                                @onclick="() => OnSelectCategory.InvokeAsync(category.Id)">
                                <span>@CategoryIconSelector(category.Id)</span>
                                <span>@Text.LocalizeCategoryLabel(category.Label)</span>
                            </button>
                        }
                    </section>
                </div>

                @if (State.IsUsingFallbackData)
                {
                    <aside class="offline-banner">
                        <strong>@Text.SavedDataModeLabel</strong>
                        <span>@State.SyncMessage</span>
                    </aside>
                }
            </div>

            @if (State.ShowNotifications)
            {
                <aside class="notification-panel">
                    <div class="notification-panel__surface">
                        <div class="panel-header">
                            <div class="notification-panel__copy">
                                <span class="eyebrow">@Text.NotificationEyebrow</span>
                                <strong>@Text.NotificationTitle</strong>
                            </div>
                            <button type="button" class="panel-close" @onclick="OnToggleNotifications">@Text.CloseButton</button>
                        </div>

                        <div class="panel-list">
                            @if (State.Notifications.Count == 0)
                            {
                                <article class="panel-item panel-item--empty">
                                    <strong>@Text.NoNotificationsTitle</strong>
                                    <p>@Text.NoNotificationsDescription</p>
                                </article>
                            }
                            else
                            {
                                @foreach (var notification in State.Notifications)
                                {
                                    <article class="panel-item">
                                        <strong>@notification.Title</strong>
                                        <p>@notification.Body</p>
                                        <span>@notification.TimeLabel</span>
                                    </article>
                                }
                            }
                        </div>
                    </div>
                </aside>
            }

            @if (DirectionsNotice is not null)
            {
                <aside class="walking-route-banner @(DirectionsNotice.IsLoading ? "is-loading" : string.Empty)" role="status" aria-live="polite">
                    <div class="walking-route-banner__icon">🚶</div>
                    <div class="walking-route-banner__copy">
                        <strong>@DirectionsNotice.Title</strong>
                        <span>@DirectionsNotice.StatusLabel</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(DirectionsNotice.DistanceLabel) || !string.IsNullOrWhiteSpace(DirectionsNotice.DurationLabel))
                    {
                        <div class="walking-route-banner__metrics">
                            @if (!string.IsNullOrWhiteSpace(DirectionsNotice.DistanceLabel))
                            {
                                <span>@DirectionsNotice.DistanceLabel</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(DirectionsNotice.DurationLabel))
                            {
                                <span>@DirectionsNotice.DurationLabel</span>
                            }
                        </div>
                    }
                    <button type="button" class="walking-route-banner__clear" @onclick="OnClearDirections">@Text.ClearDirectionsButton</button>
                </aside>
            }

            <button
                type="button"
                class="map-fab-button map-fab-button--locate map-locate-control @(State.ShowPoiSheet ? "map-locate-control--sheet-open" : string.Empty)"
                @onclick="OnCenterOnUser"
                aria-label="@Text.CenterOnUserLabel"
                title="@Text.CenterOnUserLabel">⌖</button>

            @if (State.SelectedPoi is not null && State.ShowPoiSheet)
            {
                <section class="poi-sheet poi-sheet--floating">
                    <div class="poi-sheet__grabber"></div>
                    <div class="poi-sheet__head">
                        <div class="poi-sheet__icon">@CategoryIconSelector(State.SelectedPoi.CategoryId)</div>
                        <div class="poi-sheet__title">
                            <h3>@State.SelectedPoi.Name</h3>
                            <span class="poi-sheet__badge">@PoiCategoryLabelSelector(State.SelectedPoi)</span>
                            <p class="poi-sheet__location">📍 @SelectedPoiDistanceLabel • @State.SelectedPoi.District</p>
                        </div>
                        <button type="button" class="poi-sheet__close" @onclick="OnClosePoiSheet">@Text.CloseButton</button>
                    </div>

                    <div class="poi-sheet__meta-chips">
                        <span class="poi-meta-chip">🎯 @Text.GeofenceRadiusLabel @State.SelectedPoi.GeofenceRadiusMeters m</span>
                        <span class="poi-meta-chip">⭐ @Text.PriorityLabel @State.SelectedPoi.Priority</span>
                        <span class="poi-meta-chip">🔊 @Text.LocalizeKnownStatus(State.SelectedPoi.StatusLabel)</span>
                        <span class="poi-meta-chip">🌐 @Text.FormatLanguageCount(State.SelectedPoi.AvailableLanguageCount)</span>
                    </div>

                    <div class="poi-sheet__description">
                        <p>@State.SelectedPoi.GetDescriptionForLanguage(SelectedLanguageCode)</p>
                        <strong>@State.SelectedPoi.GetHighlightForLanguage(SelectedLanguageCode)</strong>
                    </div>

                    <div class="poi-sheet__audio-status">
                        <span class="poi-meta-chip">🎧 @MapPoiAudioStatus</span>
                    </div>

                    @if (AudioLanguages.Count > 0)
                    {
                        <label class="poi-sheet__language-picker">
                        <span>@Text.NarrationLanguageLabel()</span>
                            <select value="@SelectedLanguageCode" @onchange="OnAudioLanguageChangedAsync">
                                @foreach (var language in AudioLanguages)
                                {
                                    <option value="@language.Code">@language.ChipLabel @language.Label</option>
                                }
                            </select>
                        </label>
                    }

                    @if (!string.IsNullOrWhiteSpace(QueuedPoiStatus))
                    {
                        <div class="poi-sheet__queue">
                            <span class="poi-meta-chip poi-meta-chip--queue">⏭️ @QueuedPoiStatus</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(DirectionsStatus))
                    {
                        <div class="poi-sheet__directions">
                            <span class="poi-meta-chip poi-meta-chip--route">🚶 @DirectionsStatus</span>
                        </div>
                    }

                    <div class="sheet-actions sheet-actions--poi">
                        <button type="button" class="secondary-pill" @onclick="OnClosePoiSheet">@Text.HideButton</button>
                        <button type="button" class="secondary-pill" @onclick="OnOpenDirections">@Text.DirectionsButton</button>
                        <button type="button" class="secondary-pill" @onclick="OnOpenPoiDetail">@Text.DetailButton</button>
                        <button type="button" class="primary-pill" @onclick="OnPlaySelectedPoi">@Text.ListenNowButton</button>
                    </div>
                </section>
            }

            @if (State.ActiveProximity is not null)
            {
                <aside @key="State.ActiveProximity.PoiId" class="geofence-toast geofence-toast--notice" role="status" aria-live="polite">
                    <strong>@Text.NearbyPoiPrefix @State.ActiveProximity.PoiName</strong>
                    <span>@GeofenceToastMessageProvider()</span>
                    @if (!string.IsNullOrWhiteSpace(GeofenceQueueBadgeProvider()))
                    {
                        <span class="geofence-toast__queue">@GeofenceQueueBadgeProvider()</span>
                    }
                </aside>
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public VisitorShellState State { get; set; } = default!;
    [Parameter] public VisitorUiText Text { get; set; } = VisitorUiTextCatalog.ForLanguage("vi");
    [Parameter] public Func<string, string> CategoryChipClassSelector { get; set; } = static _ => string.Empty;
    [Parameter] public Func<string, string> CategoryIconSelector { get; set; } = static _ => string.Empty;
    [Parameter] public Func<string> GeofenceToastMessageProvider { get; set; } = static () => string.Empty;
    [Parameter] public Func<string?> GeofenceQueueBadgeProvider { get; set; } = static () => null;
    [Parameter] public Func<VisitorPoi, string> PoiCategoryLabelSelector { get; set; } = static poi => poi.CategoryLabel;
    [Parameter] public EventCallback OnToggleNotifications { get; set; }
    [Parameter] public EventCallback<string> OnSelectCategory { get; set; }
    [Parameter] public EventCallback OnCenterOnUser { get; set; }
    [Parameter] public EventCallback OnClosePoiSheet { get; set; }
    [Parameter] public string MapPoiAudioStatus { get; set; } = string.Empty;
    [Parameter] public string SelectedPoiDistanceLabel { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<VisitorLanguageOption> AudioLanguages { get; set; } = [];
    [Parameter] public string SelectedLanguageCode { get; set; } = "vi";
    [Parameter] public string? QueuedPoiStatus { get; set; }
    [Parameter] public string? DirectionsStatus { get; set; }
    [Parameter] public VisitorWalkingDirectionsNotice? DirectionsNotice { get; set; }
    [Parameter] public EventCallback OnClearDirections { get; set; }
    [Parameter] public EventCallback OnOpenDirections { get; set; }
    [Parameter] public EventCallback OnOpenPoiDetail { get; set; }
    [Parameter] public EventCallback OnPlaySelectedPoi { get; set; }
    [Parameter] public EventCallback<string> OnSelectAudioLanguage { get; set; }

    private Task OnAudioLanguageChangedAsync(ChangeEventArgs args)
    {
        var languageCode = args.Value?.ToString();
        return string.IsNullOrWhiteSpace(languageCode)
            ? Task.CompletedTask
            : OnSelectAudioLanguage.InvokeAsync(languageCode);
    }
}
